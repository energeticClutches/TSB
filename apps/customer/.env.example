# Copy to .env.local. All values here are PUBLIC (safe in the browser).
# Demo mode: runs the whole ordering flow with a built-in demo menu and simulated payments,
# no backend needed. Set to false once Supabase is connected.
VITE_DEMO=true
VITE_BRANCH_SLUG=bahadurgarh-s6
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloudflare Turnstile. This is Cloudflare's public TEST key (always passes); use the real one in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
