# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These are PUBLIC values (safe in the browser). Never put secret or service keys here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Customer ordering site (printed into table QR codes). Must be final before printing standees.
VITE_ORDER_URL=http://localhost:5174
